# MiroFish uses any OpenAI-SDK-compatible LLM endpoint.
# Official upstream currently recommends starting with a small simulation because token use can be high.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Required by the official MiroFish build.
ZEP_API_KEY=

# Optional accelerated model settings. Leave these lines commented out unless you use them.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=
